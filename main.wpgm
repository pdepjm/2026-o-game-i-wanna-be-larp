import spawner_normies.*
import contador_aura.*
import wollok.game.*
import tablero.*
import chads.*
import normies.*
import menuCartas.*
import partida_manager.*
import archivo_jardin.*
import archivo_invasion.*
import cartel.*
import proyectiles.*
import tiposNormies.*



program ChadsVsNormies {
  game.title("Chads vs Normies")
  game.width(13)
  game.height(6)
  game.cellSize(60)
  game.boardGround("Patiochadfinal.png")

  
  game.addVisual(cartel)
  menuDeCartas.mostrarMenu() //muestra el menu de cartas
  contadorSoles.mostrar()

  invasion.agregar(tipoNormieComun.crearEn(game.at(12, 2)))

  //si hay una carta seleccionable en la posicion clickeada, se selecciona esa carta

  game.onClickDo({ posicion =>
    seleccion.habilitarSeleccion(posicion)
  })

  game.onTick(2500, "avanzarNormies", {
    invasion.avanzar_invasion()
    escenario.reordenar()

  })

  game.onTick(250, "avanzarProyectiles", {
  proyectiles.avanzarTodos()
  })

  //pulsos de accion para los Chads (disparo, recursos, etc)
  game.onTick(1500, "actuarChads" , {
    jardin.plantasEnJardin().forEach({ chad => chad.actuar() })
  })

  game.onTick(1000, "actualizarGeneracionSoles", {
    jardin.plantasEnJardin().forEach({ chad =>
      chad.generarRecursos()
    })
  })

  game.onTick(12000, "auraPasiva", {
    partida.generarAuraPasiva()
  })

  game.onClickDo({posicion => 
  
    if(posicion == cartel.position()){

        cartel.actuar()
    }
  
  })

  game.onTick(10000,"spawnear normies",{
    spawnerDeNormies.spawnearNormie()

  })
  
  game.start()
}



