import wollok.game.*
import tablero.*
import chads.*
import normies.*
import menuCartas.*
import partida_manager.*
import archivo_jardin.*
import archivo_invasion.*
import cartel.*

program ChadsVsNormies {
  game.title("Chads vs Normies")
  game.width(13)
  game.height(6)
  game.cellSize(60)
  game.boardGround("Patiochadfinal.png")

  
  game.addVisual(cartel)

  menuDeCartas.mostrarMenu() //muestra el menu de cartas
  invasion.agregar(new NormieComun(position = game.at(12, 2),vida = 20,danio = 10))

  //si hay una carta seleccionable en la posicion clickeada, se selecciona esa carta

  game.onClickDo({ posicion =>
    if (menuDeCartas.hayCartaEn(posicion)) {
            
      seleccion.elegirChad(menuDeCartas.chadEn(posicion))

    } else if (posicion.x() >= jardin.limitePodadora() && posicion.x() <= jardin.limiteAnchoJardin() && posicion.y() <= jardin.limiteAltoJardin()) {
      
      //si la posicion donde se clickea no excede los limites del jardin, se pasa a plantar el chad
      
      seleccion.plantarEn(posicion)

    }
  })

  game.onTick(1000, "avanzarNormies", {
    
    invasion.avanzar_invasion()
    escenario.reordenar()

  })

  
  //pulsos de accion para los Chads (disparo, recursos, etc)
  game.onTick(1500, "actuarChads" , {
    jardin.plantasEnJardin().forEach({ chad => chad.actuar() })
  })

  game.onTick(1000,"checkear vidas",{

    partida.checkearVidas()

  })

  game.onClickDo({posicion => 
  
    if(posicion == cartel.position()){

        cartel.actuar()
    }
  
  
  })


  //un foxy te viene a atacar a vos sin ninguna razon aparente
  game.onTick(3400, "foxyJumpscare", { => elFoxyQueNoInvitoNadie.jumpscare() })


  game.start()
}



